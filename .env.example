# Environment variables for Italy Taxi Service.
#
# Names and purposes only — never commit real values. The real file is `.env`,
# which `.gitignore` already excludes. On a hosting platform, set these in the
# platform's own environment/secret settings rather than in a file.

# ── Supabase ────────────────────────────────────────────────────────────────
# The project URL and the public anon key. NEXT_PUBLIC_ means both are inlined
# into the browser bundle at build time, so neither may ever hold a secret.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Full-privilege key. Server-side only — it bypasses row level security, so it
# must never be given a NEXT_PUBLIC_ prefix or referenced from a client
# component. Used by the CRM's own actions and by lead creation.
SUPABASE_SERVICE_ROLE_KEY=

# ── Email (Resend) ──────────────────────────────────────────────────────────
# When unset, email is skipped with a warning and lead capture still works.
RESEND_API_KEY=

# Where admin notifications are delivered. Defaults to the address hard-coded
# in the mailer if unset.
ADMIN_EMAIL=

# ── Cross-site lead intake (POST /api/leads) ────────────────────────────────
# The shared secret the Rome Transfer Service deployment presents as
# `Authorization: Bearer <token>`. Server-side only.
#
# While this is unset the endpoint refuses every request with 401, so leaving
# it blank disables cross-site intake rather than opening it. Generate a long
# random value, keep it only in each platform's secret manager, and set the
# new value here first when rotating.
LEAD_INTAKE_TOKEN=

# Optional. Abuse protection on the intake endpoint: requests per window, per
# client address. Defaults to 20 per 10 minutes.
#
# Note that this counter lives in process memory, so on a platform that runs
# several instances each keeps its own. For an exact limit, back it with a
# shared store.
LEAD_INTAKE_RATE_LIMIT=
LEAD_INTAKE_RATE_WINDOW_MS=

# Optional. The domain shown in the footer of confirmation emails sent to
# customers who enquired through the Rome site. Defaults to
# rometransferservice.com.
ROME_SITE_DOMAIN=
